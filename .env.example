# ---- AI provider (server-side only; never exposed to the browser) ----
# Set ONE of these. Gemini is used when both are present unless AI_PROVIDER is set.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=
# Optional: force a provider: gemini | openai
# AI_PROVIDER=gemini

# ---- Models (optional) ----
# The UI shows three tiers: Fast / Balanced / Advanced. Override the model behind each tier:
# MODEL_FAST=gemini-flash-lite-latest
# MODEL_BALANCED=gemini-3.5-flash
# MODEL_ADVANCED=gemini-pro-latest

# ---- Server (optional) ----
PORT=3001
# Max chat requests per IP per minute (0 disables)
RATE_LIMIT_PER_MINUTE=30
# OpenAI-compatible base URL (only for OPENAI provider)
# OPENAI_BASE_URL=
# Override the assistant system prompt
# SYSTEM_PROMPT=

# ---- Image generation (Create → Image) ----
# pollinations: works without a key on Pollinations' free anonymous tier (rate-limited, may watermark).
#               Set IMAGE_API_KEY (from https://enter.pollinations.ai) for the authenticated API + IMAGE_MODEL.
# gemini:       Gemini native image models; uses IMAGE_API_KEY or GEMINI_API_KEY (requires a billing-enabled tier).
IMAGE_PROVIDER=pollinations
IMAGE_API_KEY=
# IMAGE_MODEL=

# ---- Video generation (Create → Video) ----
# veo: Google Veo via the Gemini API (async jobs, image-to-video). Uses VIDEO_API_KEY or GEMINI_API_KEY.
#      Veo requires a billing-enabled Gemini API project; free-tier keys return a quota error.
VIDEO_PROVIDER=veo
VIDEO_API_KEY=
# VIDEO_MODEL=veo-3.1-fast-generate-preview

# Generated files are stored on the server and expire after this many hours.
# MEDIA_RETENTION_HOURS=72
# MEDIA_RATE_LIMIT_PER_MINUTE=10
