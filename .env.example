# Required: your OpenAI API key (server-side only, never exposed to the browser)
OPENAI_API_KEY=sk-your-key-here

# Optional: comma-separated models shown in the model picker (first is default)
OPENAI_MODELS=gpt-5-mini,gpt-5,gpt-4.1-mini
# Optional: default model (must be in OPENAI_MODELS)
# OPENAI_DEFAULT_MODEL=gpt-5-mini

# Optional: API port (Vite dev server proxies /api to it)
PORT=3001
# Optional: custom OpenAI-compatible base URL
# OPENAI_BASE_URL=
# Optional: override the assistant's system prompt
# SYSTEM_PROMPT=
