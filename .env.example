# ---- AI provider (server-side only; never exposed to the browser) ----
# Set ONE of these. Gemini is used when both are present unless AI_PROVIDER is set.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=
# Optional: force a provider: gemini | openai
# AI_PROVIDER=gemini

# ---- Models (optional) ----
# The UI shows three tiers: Fast / Balanced / Advanced. Override the model behind each tier:
# MODEL_FAST=gemini-flash-lite-latest
# MODEL_BALANCED=gemini-3.5-flash
# MODEL_ADVANCED=gemini-pro-latest

# ---- Server (optional) ----
PORT=3001
# Max chat requests per IP per minute (0 disables)
RATE_LIMIT_PER_MINUTE=30
# OpenAI-compatible base URL (only for OPENAI provider)
# OPENAI_BASE_URL=
# Override the assistant system prompt
# SYSTEM_PROMPT=
